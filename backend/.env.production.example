# ============================================================
# JudgeTracker Atlas — Production Environment Template
# ============================================================
# Copy this file to .env (never commit the real .env to git).
# All variables use the JTA_ prefix.
# See docs/config_reference.md for full documentation.
# ============================================================

# --------------- Core ----------------------------------------
JTA_APP_ENV=production
JTA_DATABASE_URL=postgresql+psycopg://atlas_user:CHANGE_ME@db:5432/judgetracker

# --------------- Security ------------------------------------
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JTA_JWT_SECRET_KEY=REPLACE_WITH_RANDOM_48_CHAR_SECRET

# Must be true once at least one admin user has been created.
JTA_JWT_AUTH_ENABLED=true

# Bootstrap secret for the first admin account registration.
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
JTA_FIRST_ADMIN_SECRET=REPLACE_WITH_RANDOM_32_CHAR_SECRET

# Legacy shared-token admin auth — MUST stay false in production.
JTA_ENABLE_LEGACY_ADMIN_TOKEN=false

# --------------- CORS ----------------------------------------
# Comma-separated HTTPS URLs; wildcard not allowed in production.
JTA_CORS_ORIGINS=https://your-frontend-domain.example.com

# --------------- Rate Limiting / Redis -----------------------
JTA_RATE_LIMIT_ENABLED=true
JTA_RATE_LIMIT_BACKEND=redis
JTA_REDIS_URL=redis://redis:6379/0

# Per-endpoint limits (requests per minute)
JTA_RATE_LIMIT_PUBLIC=100
JTA_RATE_LIMIT_ADMIN=30
JTA_RATE_LIMIT_MAP=60
JTA_RATE_LIMIT_INGESTION=10

# --------------- Evidence Store ------------------------------
JTA_EVIDENCE_STORE_REQUIRED=true
JTA_EVIDENCE_STORE_ROOT=/data/evidence
JTA_EVIDENCE_STORE_PROBE_WRITE=true

# --------------- Egress Proxy (required) ---------------------
# Route all outbound ingestion fetches through an HTTP/HTTPS proxy to
# mitigate DNS rebinding attacks.  OR set the infrastructure override:
#   JTA_ALLOW_DIRECT_PROD_FETCH_WITH_NETWORK_POLICY=1
JTA_FETCH_EGRESS_PROXY=http://egress-proxy:3128

# --------------- Source Registry / Ingestion -----------------
JTA_SEED_SOURCE_REGISTRY=true
JTA_AUTO_SEED=false
JTA_ENABLE_SCHEDULER=false

# --------------- External Data Sources -----------------------
# CanLII REST API v1 key (Canadian case law)
JTA_CANLII_API_KEY=REPLACE_WITH_CANLII_KEY

# CourtListener API token (US federal courts)
# JTA_COURTLISTENER_API_TOKEN=

# --------------- Optional Features --------------------------
JTA_ENABLE_ADMIN_IMPORTS=false
JTA_ENABLE_ADMIN_REVIEW=false
JTA_ENABLE_PUBLIC_EVENT_POST=false
JTA_ENABLE_PUBLIC_RELATIONSHIP_ARCS=false
JTA_ENABLE_PUBLIC_PLATFORM=false

# --------------- Logging & Observability --------------------
# (Add your observability stack variables here, e.g. OTEL_EXPORTER_OTLP_ENDPOINT)
