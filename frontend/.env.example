# Frontend environment variables
# Copy this file to .env.local for local development.
# Do NOT commit .env.local to version control.

# API base URL — must match the backend port
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Feature flags (frontend)
# Keep false for alpha; only enable after proof gates pass
NEXT_PUBLIC_ENABLE_LIVE_MAP=false
NEXT_PUBLIC_ENABLE_ADMIN_UI=true
NEXT_PUBLIC_ENABLE_PUBLIC_PLATFORM=false

# Alpha label shown in the top bar (set to "false" to hide)
NEXT_PUBLIC_SHOW_ALPHA_BANNER=true

# Sentry (optional — leave empty to disable error reporting)
# NEXT_PUBLIC_SENTRY_DSN=
