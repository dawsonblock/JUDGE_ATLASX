judge_atlas_*.zip

# Proof-generated artifacts — produced by make proof; never commit
REPAIR_REPORT.md
*_PROOF.md
*_PROOF_*.md

# ---- Non-shipping / reference trees ----------------------------------------
# These directories are present for research, vendored dependencies, or
# developer tooling. They are NOT part of the release archive and MUST NOT
# contain runtime product code or secrets.
research/
external/
Research /
# tools/CLI-Anything-main  -- external CLI tooling reference

# Exclude any local builds that may be produced inside research subtrees
research/**/__pycache__/
research/**/.pytest_cache/
research/**/.mypy_cache/
research/**/.ruff_cache/
research/**/*.py[cod]
research/**/node_modules/
research/**/.next/
external/**/__pycache__/
external/**/*.py[cod]
external/**/node_modules/
